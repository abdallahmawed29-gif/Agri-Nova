function App() {
  const [tab, setTab] = useState('home')
  const [group, setGroup] = useState('خضروات')
  const [crop, setCrop] = useState('طماطم')
  const [age, setAge] = useState('30')
  const [question, setQuestion] = useState('')
  const [image, setImage] = useState(null)
  const [answer, setAnswer] = useState('')

  const info = useMemo(
    () =>
      cropInfo[crop] || {
        water: 'يحدد حسب المرحلة والظروف',
        soil: 'يحدد حسب المحصول وتحليل التربة',
        salinity: 'تختلف حسب الصنف',
        tips: 'ارفع صورة أو اسأل المساعد للحصول على تحليل أكثر تخصيصًا.'
      },
    [crop]
  )

  function analyze() {
    setAnswer(
      `تحليل مبدئي لـ ${crop}: العمر ${age} يوم.

الاحتياج المائي:
${info.water}

التربة المناسبة:
${info.soil}

الملوحة:
${info.salinity}

نصيحة:
${info.tips}

تنبيه: هذا تحليل تجريبي للواجهة وليس تشخيصًا زراعيًا حقيقيًا.`
    )
  }

  function changeGroup(value) {
    setGroup(value)
    setCrop(crops[value][0])
    setAnswer('')
  }

  function askAssistant() {
    if (!question.trim()) {
      setAnswer('اكتب السؤال الأول.')
      return
    }

    setAnswer(
      `إجابة تجريبية لسؤالك:

${question}

ابدأ بفحص رطوبة التربة والجذور والأوراق، وسجل ظروف الري والتسميد. في النسخة الإنتاجية يمكن ربط هذه الواجهة بنموذج AI زراعي حقيقي وقاعدة بيانات للمحاصيل والطقس.`
    )
  }

  return (
    <div className="app">
      <header>
        <div className="brand">
          <span className="brand-icon">🌱</span>

