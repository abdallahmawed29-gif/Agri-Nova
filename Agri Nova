                </p>
              </article>

              <article>
                <span className="card-icon">🧪</span>

                <h3>التربة والملوحة</h3>

                <strong>{info.salinity}</strong>

                <p>{info.soil}</p>
              </article>

              <article>
                <span className="card-icon">🩺</span>

                <h3>برنامج اليوم</h3>

                <strong>مراجعة الحقل</strong>

                <p>{info.tips}</p>
              </article>
            </section>
          </>
        )}

        {tab === 'diagnose' && (
          <section className="panel page">
            <div className="panel-title">
              <div>
                <h2>تشخيص النبات بالصور</h2>
                <p>
                  ارفع صورة واضحة للنبات للحصول على تحليل مبدئي.
                </p>
              </div>

              <span>وضع تجريبي</span>
            </div>

            <label className="upload">
              <div className="upload-icon">📷</div>

              <strong>
                {image
                  ? 'تم اختيار الصورة'
