              />
            </label>

            {image && (
              <div className="file">
                📎 {image.name}
              </div>
            )}

            <button
              className="cta"
              onClick={analyze}
            >
              اعمل تحليل مبدئي
            </button>

            {answer && (
              <div className="result">
                {answer}
              </div>
            )}
          </section>
        )}

        {tab === 'assistant' && (
          <section className="panel page">
            <div className="panel-title">
              <div>
                <h2>اسأل المهندس AI</h2>
                <p>
                  اسأل عن الري أو التسميد أو التربة أو الآفات.
                </p>
              </div>

              <span>مساعد زراعي</span>
            </div>

            <textarea
