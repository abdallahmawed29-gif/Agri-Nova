                      </option>
                    ))}
                  </select>
                </label>

                <label>
                  <span>عمر النبات / المحصول (يوم)</span>

                  <input
                    type="number"
                    min="0"
                    value={age}
                    onChange={e => setAge(e.target.value)}
                  />
                </label>
              </div>
            </section>

            <section className="cards">
              <article>
                <span className="card-icon">💧</span>

                <h3>المياه</h3>

                <strong>{info.water}</strong>

                <p>
